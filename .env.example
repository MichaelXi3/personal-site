# Only needed by `npm run photos:unsplash`.
UNSPLASH_ACCESS_KEY=
# The application name you registered on Unsplash. Used in referral links.
UNSPLASH_APP_NAME=

# Only needed by `npm run photos` when uploading to Cloudflare R2.
# Leave all of these empty to write photos to public/photos instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket, without a trailing slash.
R2_PUBLIC_URL=
