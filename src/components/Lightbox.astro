<dialog id="lightbox" aria-label="Photo viewer">
  <img alt="" />
  <a data-source hidden>View on Unsplash</a>
  <button type="button" data-action="close" aria-label="Close">×</button>
  <button type="button" data-action="prev" aria-label="Previous photo">‹</button>
  <button type="button" data-action="next" aria-label="Next photo">›</button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("#lightbox")!;
  const image = dialog.querySelector("img")!;
  const source = dialog.querySelector<HTMLAnchorElement>("[data-source]")!;
  let items: HTMLAnchorElement[] = [];
  let index = 0;

  function show(next: number) {
    index = (next + items.length) % items.length;
    image.src = items[index].href;
    image.alt = items[index].dataset.alt ?? "";
    source.hidden = !items[index].dataset.link;
    source.href = items[index].dataset.link ?? "";
  }

  for (const album of document.querySelectorAll<HTMLElement>("[data-album]")) {
    const photos = [...album.querySelectorAll<HTMLAnchorElement>("[data-photo]")];
    photos.forEach((photo, position) => {
      photo.addEventListener("click", (event) => {
        // Keep native behavior for opening a photo in a new tab.
        if (event.metaKey || event.ctrlKey || event.shiftKey) return;
        event.preventDefault();
        items = photos;
        show(position);
        dialog.showModal();
      });
    });
  }

  dialog.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    const action = target.dataset.action;
    if (target === source) return;
    if (action === "prev") show(index - 1);
    else if (action === "next") show(index + 1);
    else if (target !== image) dialog.close();
  });

  dialog.addEventListener("keydown", (event) => {
    if (event.key === "ArrowLeft") show(index - 1);
    if (event.key === "ArrowRight") show(index + 1);
  });

  dialog.addEventListener("close", () => image.removeAttribute("src"));
</script>

<style>
  dialog {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(10 10 10 / 97%);
  }

  dialog[open] {
    display: grid;
    place-items: center;
  }

  dialog::backdrop {
    background: transparent;
  }

  img {
    width: auto;
    max-width: calc(100vw - 2rem);
    max-height: calc(100dvh - 2rem);
    object-fit: contain;
  }

  [data-source] {
    position: absolute;
    bottom: 0.75rem;
    left: 50%;
    padding: 0.3rem 0.8rem;
    border-radius: 99px;
    background: rgb(0 0 0 / 60%);
    color: #fff;
    font-size: 0.85rem;
    transform: translateX(-50%);
  }

  [data-source][hidden] {
    display: none;
  }

  button {
    position: absolute;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 45%);
    color: #fff;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }

  button:hover {
    background: rgb(255 255 255 / 20%);
  }

  [data-action="close"] {
    top: 0.75rem;
    right: 0.75rem;
  }

  [data-action="prev"] {
    top: calc(50% - 1.375rem);
    left: 0.75rem;
  }

  [data-action="next"] {
    top: calc(50% - 1.375rem);
    right: 0.75rem;
  }
</style>
